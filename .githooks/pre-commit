#!/bin/bash
#
# pre-commit hook - Branch-aware file protection
#
# This hook prevents files from being committed to the wrong branch.
# It provides clear, agent-friendly error messages with guidance on how to fix.
#
# Rules:
#   testing/develop  - Only test infrastructure (e2e/, .devcontainer/, etc.)
#   agents/develop   - Only documentation and agent config (*.md, .claude/, etc.)
#   develop/main     - Warns against direct commits (prefer feature branches)
#   feature/*        - Everything allowed (integration work)
#

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Get current branch
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD)

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0  # No files staged, nothing to check
fi

# Helper function to print blocked message
print_blocked() {
    local file="$1"
    local branch="$2"
    local allowed="$3"
    local target="$4"

    echo ""
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}${BOLD}  ✗ COMMIT BLOCKED${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "  ${BOLD}File:${NC}   $file"
    echo -e "  ${BOLD}Branch:${NC} $branch"
    echo ""
    echo -e "  ${YELLOW}This branch only accepts:${NC}"
    echo -e "    $allowed"
    echo ""
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${CYAN}  HOW TO FIX${NC}"
    echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "  Option 1: Unstage this file and commit the rest"
    echo -e "    ${GREEN}git reset HEAD $file${NC}"
    echo ""
    echo "  Option 2: Route this commit to the correct branch"
    echo "    First, commit without this file, then:"
    echo -e "    ${GREEN}./scripts/git/route-commit.sh HEAD $target${NC}"
    echo ""
    echo "  Option 3: Switch to correct worktree"
    echo -e "    ${GREEN}cd ../orcpub-$target${NC}"
    echo "    Then make your changes there"
    echo ""
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
}

# Helper to check if file matches any pattern in a list
matches_patterns() {
    local file="$1"
    shift
    local patterns=("$@")

    for pattern in "${patterns[@]}"; do
        case "$file" in
            $pattern) return 0 ;;
        esac
    done
    return 1
}

#
# Branch-specific rules
#

case "$BRANCH" in
    testing/develop)
        # Only allow test infrastructure files
        ALLOWED_PATTERNS=(
            "e2e/*"
            "e2e/**/*"
            ".devcontainer/*"
            ".devcontainer/**/*"
            "test/*"
            "test/**/*"
            ".github/workflows/*"
            ".github/*"
            "scripts/git/*"
            ".githooks/*"
            "Dockerfile*"
            "docker-compose*"
            "*.dockerfile"
            "*.sh"
        )
        ALLOWED_DESC="e2e/*, .devcontainer/*, test/*, .github/*, scripts/git/*, .githooks/*, *.sh"
        TARGET_SUGGESTION="develop"

        for file in $STAGED_FILES; do
            if ! matches_patterns "$file" "${ALLOWED_PATTERNS[@]}"; then
                print_blocked "$file" "$BRANCH" "$ALLOWED_DESC" "$TARGET_SUGGESTION"
                exit 1
            fi
        done
        ;;

    agents/develop)
        # Only allow documentation and agent config
        ALLOWED_PATTERNS=(
            "*.md"
            "CLAUDE.md"
            ".claude/*"
            ".claude/**/*"
            "agents/*"
            "agents/**/*"
            "docs/*"
            "docs/**/*"
            "scripts/git/*"
            ".githooks/*"
        )
        ALLOWED_DESC="*.md, CLAUDE.md, .claude/*, agents/*, docs/*, scripts/git/*"
        TARGET_SUGGESTION="develop"

        for file in $STAGED_FILES; do
            if ! matches_patterns "$file" "${ALLOWED_PATTERNS[@]}"; then
                print_blocked "$file" "$BRANCH" "$ALLOWED_DESC" "$TARGET_SUGGESTION"
                exit 1
            fi
        done
        ;;

    develop|main|master)
        # Warn about direct commits, suggest feature branch
        echo ""
        echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${YELLOW}  ⚠ WARNING: Direct commit to $BRANCH${NC}"
        echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo "  Consider using a feature branch instead:"
        echo -e "    ${GREEN}git checkout -b feature/my-change${NC}"
        echo ""
        echo "  Proceeding with commit to $BRANCH..."
        echo ""
        # Allow but warn - don't block
        ;;

    feature/*|integrate/*|claude/*|integration/*)
        # Integration branches allow everything
        # This is where mixed work happens before routing
        ;;

    *)
        # Unknown branch pattern - allow but inform
        echo -e "${BLUE}ℹ${NC} Committing to branch: $BRANCH"
        ;;
esac

# All checks passed
exit 0

#!/usr/bin/env bash
# pre-push guard (reminder, not an auto-fold): refuse to push a commit that still
# carries docs/branch-changelog.md onto integration / develop / main. Mirrors
# .github/workflows/changelog-guard.yml so a forgotten fold is caught locally
# instead of on CI. The fold itself stays a deliberate manual step:
#   scripts/fold-branch-changelog.sh "<release>"    (then commit, then push)
#
# Armed for every worktree by scripts/agent-setup.sh on agents/develop (docs/kb/agent-hooks.md).

status=0
zero="0000000000000000000000000000000000000000"

# Current in-progress release = the first "## [Name]" in CHANGELOG.md, so the
# suggested fold command is copy-pasteable. Falls back to a placeholder.
release="$(grep -m1 -oE '^## \[[^]]+\]' CHANGELOG.md 2>/dev/null | sed -E 's/^## \[(.+)\]$/\1/')"
release="${release:-<release>}"

pushed_refs="$(cat)"
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                    # branch deletion — skip
  case "$remote_ref" in
    refs/heads/integration|refs/heads/develop|refs/heads/main)
      guarded=1
      if git cat-file -e "${local_sha}:docs/branch-changelog.md" 2>/dev/null; then
        target="${remote_ref#refs/heads/}"
        echo "" >&2
        echo "  pre-push blocked: docs/branch-changelog.md is still un-folded on the commit" >&2
        echo "  bound for '${target}'. Fold it into CHANGELOG.md, then commit and re-push:" >&2
        echo "" >&2
        echo "      scripts/fold-branch-changelog.sh \"${release}\"" >&2
        echo "" >&2
        echo "  (Decide whether this branch earned a '## Highlights' before folding —" >&2
        echo "   see docs/branch-changelog.template.md. agents: --no-verify needs the owner's yes (AGENTS.md).)" >&2
        echo "" >&2
        status=1
      fi
      ;;
  esac
done <<< "$pushed_refs"

# Same rules CI applies, run here so a style problem is a local message rather than
# a red build after the merge. Skipped when python3 is absent; CI still catches it.
if [ "${guarded:-0}" = "1" ] && [ -x scripts/lint-changelog.py ] && command -v python3 >/dev/null 2>&1; then
  if ! scripts/lint-changelog.py >/dev/null 2>&1; then
    echo "" >&2
    echo "  pre-push blocked: CHANGELOG.md does not follow the house style." >&2
    echo "" >&2
    scripts/lint-changelog.py 2>&1 | sed -E 's/^::error [^:]*::/    /; s/^/  /' >&2
    echo "" >&2
    echo "  House style: docs/branch-changelog.template.md" >&2
    echo "  (agents: --no-verify needs the owner's yes (AGENTS.md).)" >&2
    echo "" >&2
    status=1
  fi
fi

# Agent attribution trailers: commit-msg strips them, but only where it is armed (a cloud session's
# first commits can precede the setup script). Checks the commits this push adds, not history.
while read -r _l local_sha remote_ref _r; do
  [ "$local_sha" = "$zero" ] && continue
  bad="$(git log --format='%h %s%n%b' "$local_sha" --not --remotes 2>/dev/null |
    grep -iE '^(Co-Authored-By:[[:space:]]*Claude|Claude-Session:|Generated with \[?Claude Code)|claude\.ai/code/session' | head -3)"
  if [ -n "$bad" ]; then
    echo "" >&2
    echo "  pre-push blocked: commits bound for '${remote_ref#refs/heads/}' carry agent attribution trailers:" >&2
    echo "$bad" | sed 's/^/      /' >&2
    echo "  Reword them (git rebase, not -i: git filter-branch --msg-filter or git commit --amend for the tip)" >&2
    echo "  and run scripts/agent-setup.sh so commit-msg is armed. agents: --no-verify needs the owner's yes." >&2
    echo "" >&2
    status=1
  fi
done < <(printf '%s\n' "$pushed_refs")

# Heads-up, never blocks: a push that changes the files deployment depends on sets off the heavy
# Docker checks on its PR (about 20 minutes). The file list is read from that workflow, so the two
# cannot drift apart.
heavy_wf=.github/workflows/docker-heavy.yml
if [ -f "$heavy_wf" ]; then
  patterns="$(awk '/^    paths:/{p=1;next} p&&/^      - /{gsub(/^      - |'"'"'/,"");print;next} p{exit}' "$heavy_wf")"
  while read -r _l local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    # The whole branch against integration, not just this push: GitHub matches a PR's paths filter
    # against the PR's full diff, so one deployment file anywhere on the branch runs it every push.
    base="$(git merge-base "$local_sha" origin/integration 2>/dev/null)" || continue
    hits=""
    set -f  # the patterns are globs to match, not to expand against files on disk
    for f in $(git diff --name-only "$base" "$local_sha" 2>/dev/null); do
      for pat in $patterns; do
        case "$pat" in
          */\*\*) [ "${f#"${pat%\*\*}"}" != "$f" ] && hits="$hits $f" ;;
          *) case "$f" in $pat) hits="$hits $f" ;; esac ;;  # unquoted: a glob, so docker-compose*.yaml matches
        esac
      done
    done
    set +f
    if [ -n "$hits" ]; then
      branch="${remote_ref#refs/heads/}"
      echo "" >&2
      echo "  heads-up: this branch changes files deployment depends on:$hits" >&2
      echo "  Its PR into develop or integration runs the heavy Docker checks (about 20 minutes) on every push." >&2
      echo "  To run them by hand (works only once docker-heavy.yml is on develop, the default branch):" >&2
      echo "      gh workflow run docker-heavy.yml --ref $branch" >&2
      echo "  A newer push cancels an older run; the PR label 'heavy-docker: later' pauses them." >&2
      echo "" >&2
    fi
  done < <(printf '%s\n' "$pushed_refs")
fi

exit $status

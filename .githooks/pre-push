#!/usr/bin/env bash
# pre-push guard (reminder, not an auto-fold): refuse to push a commit that still
# carries docs/branch-changelog.md onto integration / develop / main, or that
# leaves a shipped item sitting in docs/TODO.md. Mirrors changelog-guard.yml and
# roadmap-guard.yml so a forgotten fold or an unpruned roadmap is caught locally
# instead of on CI. Both stay deliberate manual steps:
#   scripts/fold-branch-changelog.sh "<release>"    (then commit, then push)
#   ... and take that work's section out of docs/TODO.md in the same pass.
#
# Activate once per clone:  scripts/setup-hooks.sh   (or: git config core.hooksPath .githooks)

status=0
zero="0000000000000000000000000000000000000000"

# Current in-progress release = the first "## [Name]" in CHANGELOG.md, so the
# suggested fold command is copy-pasteable. Falls back to a placeholder.
release="$(grep -m1 -oE '^## \[[^]]+\]' CHANGELOG.md 2>/dev/null | sed -E 's/^## \[(.+)\]$/\1/')"
release="${release:-<release>}"

while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                    # branch deletion — skip
  case "$remote_ref" in
    refs/heads/integration|refs/heads/develop|refs/heads/main)
      guarded=1
      guarded_sha="$local_sha"          # the commit actually bound for a guarded branch
      if git cat-file -e "${local_sha}:docs/branch-changelog.md" 2>/dev/null; then
        target="${remote_ref#refs/heads/}"
        echo "" >&2
        echo "  pre-push blocked: docs/branch-changelog.md is still un-folded on the commit" >&2
        echo "  bound for '${target}'. Fold it into CHANGELOG.md, then commit and re-push:" >&2
        echo "" >&2
        echo "      scripts/fold-branch-changelog.sh \"${release}\"" >&2
        echo "" >&2
        echo "  (Decide whether this branch earned a '## Highlights' before folding —" >&2
        echo "   see docs/branch-changelog.template.md. To bypass once: git push --no-verify.)" >&2
        echo "" >&2
        status=1
      fi
      ;;
  esac
done

# Same rules CI applies, run here so a style problem is a local message rather than
# a red build after the merge. Skipped when python3 is absent; CI still catches it.
if [ "${guarded:-0}" = "1" ] && [ -x scripts/lint-changelog.py ] && command -v python3 >/dev/null 2>&1; then
  if ! scripts/lint-changelog.py >/dev/null 2>&1; then
    echo "" >&2
    echo "  pre-push blocked: CHANGELOG.md does not follow the house style." >&2
    echo "" >&2
    scripts/lint-changelog.py 2>&1 | sed -E 's/^::error [^:]*::/    /; s/^/  /' >&2
    echo "" >&2
    echo "  House style: docs/branch-changelog.template.md" >&2
    echo "  (To bypass once: git push --no-verify.)" >&2
    echo "" >&2
    status=1
  fi
fi

# The roadmap's own fold-time rule: a section still marked "Shipped on ..." is
# finished work presented as pending. Checked against the COMMIT being pushed,
# not the working tree, so uncommitted edits neither hide a problem nor invent
# one -- the same thing the branch-changelog check above does with cat-file.
if [ "${guarded:-0}" = "1" ] && [ -x scripts/lint-todo.py ] && command -v python3 >/dev/null 2>&1; then
  pushed_todo="$(mktemp)"
  if git show "${guarded_sha}:docs/TODO.md" > "$pushed_todo" 2>/dev/null; then
    if ! scripts/lint-todo.py --strict "$pushed_todo" >/dev/null 2>&1; then
      echo "" >&2
      echo "  pre-push blocked: docs/TODO.md still carries work that has shipped." >&2
      echo "" >&2
      scripts/lint-todo.py --strict "$pushed_todo" 2>&1 \
        | sed -E "s#$pushed_todo#docs/TODO.md#g; s/^::error [^:]*::/    /; s/^/  /" >&2
      echo "" >&2
      echo "  Take the section out, or cut it down to what it left undecided and set" >&2
      echo "  Status back to Open. Rules: docs/CONTRIBUTING.md" >&2
      echo "  (To bypass once: git push --no-verify.)" >&2
      echo "" >&2
      status=1
    fi
  fi
  rm -f "$pushed_todo"
fi

exit $status

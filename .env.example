# ============================================================================
# Dungeon Master's Vault — Docker Environment Configuration
#
# Copy this file to .env and update the values:
#   cp .env.example .env
#
# Or run the setup script to generate .env with secure random values:
#   ./run
#
# Each line is NAME=value, read exactly as written: spaces and apostrophes are fine without
# quotes (APP_NAME=Dungeon Master's Vault). Quotes are optional. Use $$ for a literal $.
# ============================================================================

# --- Application ---
PORT=8890
TZ=America/Chicago

# Dev HTTP bind host. Defaults to loopback (localhost) so the dev server isn't
# exposed to the LAN. On WSL2 the Windows browser can't reliably reach loopback
# inside the VM, so bind 0.0.0.0. For Docker/script launches (which read .env),
# set ORCPUB_HTTP_HOST here; for `lein fig:*` use the +wsl profile instead
# (fig:* does not read .env): lein with-profile +wsl fig:dev
# ORCPUB_HTTP_HOST=0.0.0.0

# Docker image names. Set these if you tag your own builds
# (e.g., docker build -t dmv:2.6.0.0 .) so compose/swarm finds them.
# Defaults: orcpub-app, orcpub-datomic
# ORCPUB_IMAGE=dmv:2.6.0.0
# DATOMIC_IMAGE=orcpub-datomic

# --- Datomic Database ---
# Datomic Pro with dev storage protocol (required for Java 21 support)
# ADMIN_PASSWORD secures the Datomic admin interface
# DATOMIC_PASSWORD is used by both the transactor and the app to authenticate.
#   The app reads it separately and appends ?password= to DATOMIC_URL at startup,
#   so you don't need to embed the password in the URL.
# DATOMIC_URL should NOT contain ?password= (the app adds it from DATOMIC_PASSWORD).
#   Old URLs with ?password= still work — the embedded password takes priority.
ADMIN_PASSWORD=change-me-admin
DATOMIC_PASSWORD=change-me-datomic
# Left COMMENTED OUT on purpose, so that each way of running picks its own
# correct value instead of inheriting the other's:
#
#   bare metal  -> config.clj/default-datomic-uri = datomic:dev://localhost:4334/orcpub
#   docker      -> docker-compose.yaml already defaults it to the "datomic"
#                  service hostname, which only resolves inside that network
#
# Setting it here would defeat both. Compose reads this .env for substitution,
# so an uncommented localhost would override compose's own default and break
# the container; an uncommented "datomic" hostname breaks every non-Docker
# install, which is how it used to ship.
#
# Uncomment ONLY for a database somewhere else -- a remote transactor, a
# non-default port, or Datomic SQL storage:
#   DATOMIC_URL=datomic:dev://localhost:4334/orcpub
#   DATOMIC_URL=datomic:sql://orcpub?jdbc:postgresql://db:5432/datomic

# --- Transactor Tuning ---
# These rarely need changing. See docker/transactor.properties.template.
# ALT_HOST: peer fallback hostname (default: 127.0.0.1, set to service name for Swarm)
# ENCRYPT_CHANNEL: encrypt peer-transactor communication (default: true)
ALT_HOST=127.0.0.1
ENCRYPT_CHANNEL=true
# Password rotation — set OLD vars during rotation, remove after all peers reconnect
# ADMIN_PASSWORD_OLD=
# DATOMIC_PASSWORD_OLD=

# --- Security ---
# REQUIRED: JWT signing secret. Authentication will fail without this.
# 20+ random characters recommended (e.g., openssl rand -hex 16)
SIGNATURE=change-me-to-something-unique-and-long

# Content Security Policy (strict|permissive|none)
CSP_POLICY=strict

# Dev mode: no CSP header is sent at all, so Figwheel's scripts and its
# websocket (ws://localhost:3449) work. Leave this true for development.
# With DEV_MODE unset or false, CSP_POLICY=strict sends an ENFORCING policy
# whose connect-src does not include the Figwheel socket, and hot reload is
# blocked with no obvious cause.
# Must be the string "true" (case-insensitive). Any other value is treated as false.
DEV_MODE=true

# --- Proxies in front of the app ---
# true only when the site is served through Cloudflare: limits and the security log then see each
# player's real address. Leave unset otherwise, since anyone can send requests from Cloudflare.
# TRUST_CLOUDFLARE=true
# Extra proxies to trust (comma-separated addresses or ranges). Private networks, where Docker and
# Swarm proxies sit, are always trusted.
# TRUSTED_PROXIES=203.0.113.10,198.51.100.0/24

# --- Plugins ---
# URL to fetch server-hosted .orcbrew plugins on first page load.
# Leave empty to disable (plugins come only from local file imports).
# LOAD_HOMEBREW_URL=/homebrew.orcbrew

# --- Logs ---
# Defaults to project logs/ if unset
LOG_DIR=
# Docker: the app keeps crash files and unsent admin alerts in /var/log/<this name> on the host,
# on Compose and Swarm alike. A plain name only; default orcpub.
# APP_LOGS_NAME=orcpub
# Docker: each container keeps at most this many log files of this size. Defaults 5 of 10m.
# LOG_MAX_SIZE=10m
# LOG_MAX_FILES=5

# --- App memory (Docker) ---
# Java's memory options for the app. Empty: it uses 25% of its container's memory.
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# --- Remote Dev (optional) ---
# Figwheel WebSocket port for hot-reload (default: 3449)
# FIGWHEEL_PORT=3449

# Figwheel WebSocket URL override for remote environments (Gitpod, tunnels, etc.)
# Auto-detected for GitHub Codespaces — only set this for other remote setups.
# Example: wss://my-remote-host:3449/figwheel-connect
# FIGWHEEL_CONNECT_URL=

# --- Email (SMTP) ---
# EMAIL_SERVER_URL empty means this deployment cannot send mail, and registration
# then REFUSES to create accounts -- deliberately, because a dropped or typo'd
# value would otherwise silently turn a public site into open registration.
#
# To actually run without email, say so: ALLOW_UNVERIFIED_REGISTRATION=true.
# Accounts are then verified on creation and no mail is ever sent. Only sensible
# for a private instance where you hand out the accounts, since nobody proves
# they own the address they typed.
EMAIL_SERVER_URL=
EMAIL_ACCESS_KEY=
EMAIL_SECRET_KEY=
EMAIL_SERVER_PORT=587
# MUST be an address your SMTP provider is authorised to send as (SPF/DKIM),
# not just any address you own. Left blank it falls back to no-reply@example.com,
# a placeholder no provider will deliver -- set it.
EMAIL_FROM_ADDRESS=no-reply@example.com
# Where admin alerts (server errors) are emailed. Empty: alerts go to the server log only.
EMAIL_ERRORS_TO=
EMAIL_SSL=FALSE
EMAIL_TLS=FALSE

# Accept registrations without verifying the address. Requires EMAIL_SERVER_URL
# to be empty; ignored otherwise. Private instances only.
ALLOW_UNVERIFIED_REGISTRATION=false

# --- Admin alerts (optional) ---
# Where alerts wait when the mail server is down; they are sent once it is back. Default: a folder
# in the system temp directory. In Docker, point it at a volume, or a replaced container loses them.
# ALERT_SPOOL_DIR=/var/lib/orcpub/state/alerts
# Most alert emails sent in an hour; past it they are only logged. Default 20.
# ALERT_MAX_PER_HOUR=20

# --- Preferred names and portrait artists ---
# Encrypts the preferred names people give on My Account. Comma-separated id:key pairs, each
# key 32 random bytes in base64; the first encrypts, all decrypt (put a new key first to
# rotate). Keep it safe: lose it and stored names cannot be read. Without it, preferred
# names cannot be saved. Generate: echo "k1:$(openssl rand -base64 32)"
PROFILE_ENCRYPTION_KEYS=
#
# Portrait artist credits and accounts, as JSON (see ARTISTS.md). An "account" email gets an
# artist account and a welcome email when the server starts, so leave real addresses out of
# a test server unless that is wanted. Artist emails link to APP_URL (Branding, below).
# PORTRAIT_ARTISTS={"house-pack": {"name": "Fusspot", "account": "artist@example.test"}}
# Who hears about artist account changes (falls back to EMAIL_ERRORS_TO).
# EMAIL_ADMIN_TO=
#
# Where the server keeps its drawings of shared-link portraits (default: orcpub-portraits in the
# system temp directory, which the Docker image's user can write). Point several containers at one shared volume and each portrait is
# drawn once for all of them. They are derived files: deleting them only means they are drawn again.
# Mount a shared volume at this path; the image creates it for the app's user.
# PORTRAIT_STORE_DIR=/var/lib/orcpub/portraits

# --- Capacity (optional) ---
# Defaults suit most servers; see docs/ENVIRONMENT.md "Capacity" before raising them.
# Requests of any kind handled at once. Default: Pedestal's own (50 on most machines).
# ORCPUB_HTTP_MAX_THREADS=50
# Character sheets generated at once. Default: 8, or twice the CPU cores if more.
# ORCPUB_PDF_CONCURRENCY=8
# How long an export waits for a free slot before the player is told to retry, in ms. Default 30000.
# ORCPUB_PDF_QUEUE_TIMEOUT_MS=30000
# How many times the busy page retries an export by itself before waiting for a click. Default 3.
# ORCPUB_PDF_MAX_RETRIES=3
# Most spellcasting sections one sheet can grow to. Default 13 (every class).
# ORCPUB_PDF_MAX_CASTER_SECTIONS=13
# Most cards of each kind one export prints, 9 to a page. Default 198 (22 pages).
# ORCPUB_PDF_MAX_CARDS=198
# Shared-link portrait images drawn at once. Default: half the CPU cores, at least 2.
# ORCPUB_PORTRAIT_CONCURRENCY=2
# How long a portrait image waits to be drawn before the request is refused, in ms. Default 5000.
# ORCPUB_PORTRAIT_QUEUE_TIMEOUT_MS=5000

# --- Share links and passwords (optional) ---
# Largest compressed homebrew one character's share link keeps, in KB. Default 64.
# ORCPUB_SHARE_MAX_UPLOAD_KB=64
# Largest that homebrew may be once unpacked, in KB. Default 256.
# ORCPUB_SHARE_MAX_TEXT_KB=256
# Shared homebrew one account keeps across all its characters, in KB. Default 1024.
# ORCPUB_SHARE_MAX_ACCOUNT_KB=1024
# Days a share link may go unused before it is deleted (the character never is). 0 keeps them. Default 180.
# ORCPUB_SHARE_PRUNE_DAYS=180
# Check new passwords against known breaches (Have I Been Pwned). on or off. Default on.
# ORCPUB_PWNED_CHECK=on

# --- Branding (optional) ---
# The site's name, logos, links and email identity. Each has a default in fork/branding.clj;
# a value set here overrides it. See docs/BRANDING-AND-INTEGRATIONS.md.
# Site name, used in titles, emails and the legal pages.
# APP_NAME=Dungeon Master's Vault
# Public address of the site; links in emails and share previews point here.
# APP_URL=https://www.dungeonmastersvault.com
# Logo in the header and splash page: a path on this site or a web address.
# APP_LOGO_PATH=/image/dmv-logo.svg
# Picture shown when a link to the site is shared on social media.
# APP_OG_IMAGE=/image/dmv-box-logo.png
# Name in the footer's copyright line, the year shown, and where the name links to.
# APP_COPYRIGHT_HOLDER=Dungeon Master's Vault
# APP_COPYRIGHT_YEAR=2026
# APP_COPYRIGHT_URL=https://www.dungeonmastersvault.com
# Name emails come from, and who the friendlier emails are signed by.
# APP_EMAIL_SENDER_NAME=Dungeon Master's Vault Team
# APP_EMAIL_SIGNOFF=The Dungeon Master's Vault Team
# Browser tab title, and the one-line description used in search and link previews.
# APP_PAGE_TITLE=Dungeon Master's Vault
# APP_TAGLINE=A D&D 5e character builder and resource compendium
# Contact address shown to players and on the privacy page. Empty hides it.
# APP_SUPPORT_EMAIL=thDM@dungeonmastersvault.com
# Help link in the footer. Empty hides it.
# APP_HELP_URL=https://www.dungeonmastersvault.com/help/
# Longest a player may type: character notes, text fields, number fields. Defaults 50000, 255, 7.
# APP_FIELD_LIMIT_NOTES=50000
# APP_FIELD_LIMIT_TEXT=255
# APP_FIELD_LIMIT_NUMBER=7

# --- Social Links (optional) ---
# Shown in app header. Leave empty to hide a link.
# APP_SOCIAL_PATREON=https://www.patreon.com/DungeonMastersVault
# APP_SOCIAL_FACEBOOK=https://www.facebook.com/groups/252484128656613/
# APP_SOCIAL_BLUESKY=
# APP_SOCIAL_TWITTER=https://twitter.com/thdmv
# APP_SOCIAL_REDDIT=
# APP_SOCIAL_DISCORD=

# --- Analytics & Ads (optional) ---
# Third-party integrations. Leave empty to disable.
# Server-side (fork/integrations.clj) loads SDK scripts; client-side (fork/integrations.cljs)
# provides in-app hooks. CSP domains are auto-derived from these values.
# MATOMO_URL=https://analytics.dungeonmastersvault.com
# MATOMO_SITE_ID=1
# ADSENSE_CLIENT=ca-pub-3202063096003962
# ADSENSE_SLOT=4970831358

# --- Initial Admin User (optional) ---
# Set these then run: ./docker-user.sh init
# Safe to run multiple times — duplicates are skipped.
INIT_ADMIN_USER=
INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=

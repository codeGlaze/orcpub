{"Demo Content" #:orcpub.dnd.e5{:feats {:demo-tough {:key :demo-tough, :name "Demo: Tough", :option-pack "Demo Content"}}, :backgrounds {:demo-traveler {:key :demo-traveler, :name "Demo: Traveler", :option-pack "Demo Content"}}, :spells {:demo-spark {:description "You fling a mote of teal light at a creature or object within range. Make a ranged spell attack against the target. On a hit, it takes 1d8 radiant damage. The damage increases by 1d8 at 5th level (2d8), 11th level (3d8), and 17th level (4d8).", :key :demo-spark, :school "evocation", :name "Demo: Spark", :duration "Instantaneous", :level 0, :option-pack "Demo Content", :components {:verbal true, :somatic true}, :casting-time "1 action", :spell-lists {:wizard true, :sorcerer true}, :range "30 feet"}}}}
{"Demo Content" #:orcpub.dnd.e5{:feats {:demo-tough {:key :demo-tough, :name "Demo: Tough", :option-pack "Demo Content", :description "You are hardier than most: increase your Constitution by 1, and one ability score of your choice by 1.", :ability-increases [[1 :con] [1 :any]]}, :demo-versatile {:key :demo-versatile, :name "Demo: Versatile", :option-pack "Demo Content", :description "You adopt a fighting style of your choice.", :grant {:from :fighting-styles, :choose 1}}}, :backgrounds {:demo-traveler {:key :demo-traveler, :name "Demo: Traveler", :option-pack "Demo Content", :description "A life on the road toughened you: increase your Constitution by 1 and gain proficiency in Constitution saving throws.", :ability-increases [[1 :con :save]]}}, :races {:demo-tideborn {:key :demo-tideborn, :name "Demo: Tideborn", :option-pack "Demo Content", :description "Folk of the tidal deeps — quick and hardy, at home in the water and warded against flame.", :ability-increases [[2 :dex] [1 :any]], :save-proficiencies [[1 :con]], :props {:speed 30, :swimming-speed 30, :damage-resistance {:fire true}}}}, :spells {:demo-spark {:description "You fling a mote of teal light at a creature or object within range. Make a ranged spell attack against the target. On a hit, it takes 1d8 radiant damage. The damage increases by 1d8 at 5th level (2d8), 11th level (3d8), and 17th level (4d8).", :key :demo-spark, :school "evocation", :name "Demo: Spark", :duration "Instantaneous", :level 0, :option-pack "Demo Content", :components {:verbal true, :somatic true}, :casting-time "1 action", :spell-lists {:wizard true, :sorcerer true}, :range "30 feet"}}}}
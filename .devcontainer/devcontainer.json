{
  "name": "ClojureScript Lein-Figwheel Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "forwardPorts": [8890, 3449, 7888],
  "postCreateCommand": "bash ./scripts/dev-verify.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "betterthantomorrow.calva",
        "github.copilot",
        "github.copilot-chat"
      ],
      "settings": {
        "github.copilot.chat.runCommand.enabled": true
      }
    }
  }
}

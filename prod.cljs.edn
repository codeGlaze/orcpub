;; Production ClojureScript build (advanced compilation), compiled by cljs.main:
;; Run with: lein cljs:prod   (fig:prod is the same alias)
;; Docker:   lein cljs:prod
;; The metadata map below is figwheel's and is ignored by cljs.main.
^{:watch-dirs ["web/cljs" "src/cljc" "src/cljs"]
  :css-dirs []}
{:main orcpub.core
 :output-to "resources/public/js/compiled/orcpub.js"
 :asset-path "/js/compiled/out"
 :optimizations :advanced
 ;; Off in production: re-frame, Reagent and the app compile their debug-only checks and
 ;; warnings out, and common/feature-name shows its placeholder instead of throwing.
 :closure-defines {goog.DEBUG false}
 :infer-externs true
 :externs ["externs.js"]
 :pretty-print false}

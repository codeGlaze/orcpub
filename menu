#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# menu - OrcPub Development Hub
# =============================================================================
# A wrapper/hub for starting, stopping, and checking OrcPub services.
#
# Usage:
#   ./menu              Interactive menu
#   ./menu start        Start all services (calls start.sh)
#   ./menu stop         Stop all services (calls stop.sh)
#   ./menu status       Show service status (calls stop.sh --dry-run)
#   ./menu help         Show help
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- Colors ---
# TODO: Consider moving to scripts/common.sh
BOLD='\033[1m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

show_help() {
    cat << 'EOF'
OrcPub Development Hub

Usage:
  ./menu              Show interactive menu
  ./menu start        Start all services
  ./menu stop [opts]  Stop services (passes options to stop.sh)
  ./menu status       Show service status
  ./menu help         Show this help

Stop options (passed through to stop.sh):
  --yes, -y           Skip confirmation
  --force, -f         Use SIGKILL if needed
  repl|server|datomic Stop specific service

Examples:
  ./menu                      # Interactive menu
  ./menu start                # Start everything
  ./menu stop                 # Stop all (with confirmation)
  ./menu stop --yes           # Stop all without prompting
  ./menu stop repl --yes      # Stop just nREPL
  ./menu status               # Check what's running
EOF
}

interactive_menu() {
    while true; do
        echo ""
        echo -e "${BOLD}OrcPub Development Hub${NC}"
        echo "══════════════════════════════════"
        echo ""
        echo -e "  ${GREEN}Start${NC}"
        echo "  1) Start all services"
        echo "  2) Start Figwheel (ClojureScript)"
        echo "  3) Start Garden (CSS auto-compile)"
        echo ""
        echo -e "  ${YELLOW}Stop${NC}"
        echo "  4) Stop all services"
        echo "  5) Stop nREPL only"
        echo "  6) Stop server only"
        echo "  7) Stop Datomic only"
        echo ""
        echo -e "  ${CYAN}Info${NC}"
        echo "  8) Show status"
        echo ""
        echo "  q) Quit"
        echo ""
        read -p "Select [1-8, q]: " -n 1 -r choice
        echo ""

        case "$choice" in
            1)
                echo ""
                "$SCRIPT_DIR/start.sh"
                ;;
            2)
                echo ""
                echo "Starting Figwheel with dev profile..."
                lein with-profile +dev figwheel
                ;;
            3)
                echo ""
                echo "Starting Garden in auto mode (CSS watcher)..."
                lein garden auto
                ;;
            4)
                echo ""
                "$SCRIPT_DIR/stop.sh"
                ;;
            5)
                echo ""
                "$SCRIPT_DIR/stop.sh" repl
                ;;
            6)
                echo ""
                "$SCRIPT_DIR/stop.sh" server
                ;;
            7)
                echo ""
                "$SCRIPT_DIR/stop.sh" datomic
                ;;
            8)
                "$SCRIPT_DIR/stop.sh" --dry-run
                ;;
            q|Q)
                echo "Goodbye."
                exit 0
                ;;
            *)
                echo -e "${YELLOW}Invalid choice.${NC}"
                ;;
        esac
    done
}

main() {
    local command="${1:-}"

    case "$command" in
        "")
            interactive_menu
            ;;
        start)
            "$SCRIPT_DIR/start.sh"
            ;;
        stop)
            shift
            "$SCRIPT_DIR/stop.sh" "$@"
            ;;
        status)
            "$SCRIPT_DIR/stop.sh" --dry-run
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            echo "Unknown command: $command"
            show_help
            exit 1
            ;;
    esac
}

main "$@"

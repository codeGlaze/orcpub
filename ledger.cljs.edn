;; The character data page's own script (advanced compilation, always), compiled by cljs.main.
;; Run with: lein cljs:ledger   (fig:ledger is the same alias; also part of `lein build` and the
;; Docker build). The metadata map below is figwheel's and is ignored by cljs.main.
;; The page (orcpub.ledger-page) loads this and never the app bundle. character-rescue.md
^{:watch-dirs ["src/cljc" "src/cljs"]
  :css-dirs []}
{:main orcpub.ledger
 :output-to "resources/public/js/compiled/ledger.js"
 :output-dir "target/ledger/out"
 :optimizations :advanced
 :infer-externs true
 :externs ["externs.js"]
 :pretty-print false}

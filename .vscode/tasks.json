{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: Start Server",
      "type": "shell",
      "command": "lein with-profile +start-server repl",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Start Figwheel",
      "type": "shell",
      "command": "lein figwheel",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Start REPL",
      "type": "shell",
      "command": "lein repl",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Start Local Datomic",
      "type": "shell",
      "command": "bash -lc './scripts/start-datomic-local.sh'",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Init DB",
      "type": "shell",
      "command": "bash -lc 'lein run -m orcpub.dev-init'",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Tail Server Log",
      "type": "shell",
      "command": "bash -lc 'tail -F /tmp/orcpub-server.log'",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Tail Figwheel Log",
      "type": "shell",
      "command": "bash -lc 'tail -F /tmp/figwheel.log'",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Tail Datomic Log",
      "type": "shell",
      "command": "bash -lc 'tail -F /tmp/datomic-transactor.log'",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Open Interactive Menu",
      "type": "shell",
      "command": "bash -lc 'bash ./scripts/dev-menu.sh'",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Test: Run All Tests",
      "type": "shell",
      "command": "lein test",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Lint: Run Linter",
      "type": "shell",
      "command": "lein lint",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    }
  ]
}

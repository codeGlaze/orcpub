{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: Start Server",
      "type": "shell",
      "command": "lein with-profile +start-server repl",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Start Figwheel",
      "type": "shell",
      "command": "lein fig:dev",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Start REPL",
      "type": "shell",
      "command": "lein repl",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Start Datomic",
      "type": "shell",
      "command": "./scripts/start.sh datomic",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Stop All Services",
      "type": "shell",
      "command": "./scripts/stop.sh --yes",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Open Menu",
      "type": "shell",
      "command": "././menu",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Init DB",
      "type": "shell",
      "command": "./scripts/start.sh init-db",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Check Prerequisites",
      "type": "shell",
      "command": "./scripts/start.sh --check",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Tail Datomic Log",
      "type": "shell",
      "command": "tail -F ./logs/datomic.log",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Tail Server Log",
      "type": "shell",
      "command": "tail -F ./logs/server.log",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Tail Figwheel Log",
      "type": "shell",
      "command": "tail -F ./logs/figwheel.log",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Dev: Inspect Datomic Jars",
      "type": "shell",
      "command": "bash ./scripts/inspect-datomic-jars.sh",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Test: Run All Tests",
      "type": "shell",
      "command": "lein test",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Lint: Run Linter",
      "type": "shell",
      "command": "lein lint",
      "presentation": { "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    }
  ]
}

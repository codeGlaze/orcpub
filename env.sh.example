#!/bin/bash
# Environment Variables Template for OrcPub (Shell Export Method)
#
# NOTE: Most developers use profiles.clj instead (Leiningen standard)
# This is an ALTERNATIVE method if you prefer shell environment variables
#
# To use this method:
# 1. Copy: cp env.sh.example env.sh
# 2. Edit env.sh with your values
# 3. Load: source env.sh
# 4. Run: lein repl or lein figwheel
#
# env.sh is gitignored and will not be committed

# Required for production deployment
export SIGNATURE="change-me-to-something-unique-20plus-characters"
export DATOMIC_URL="datomic:free://localhost:4334/orcpub"

# Email configuration (optional - for user registration/notifications)
export EMAIL_SERVER_URL=""
export EMAIL_ACCESS_KEY=""
export EMAIL_SECRET_KEY=""
export EMAIL_SERVER_PORT="587"
export EMAIL_FROM_ADDRESS=""
export EMAIL_ERRORS_TO=""
export EMAIL_SSL="false"
export EMAIL_TLS="false"

# Google Drive Integration (optional - enables multi-device cloud storage)
# To enable: Create OAuth client ID at https://console.cloud.google.com
# Leave blank to disable Drive integration features
export GOOGLE_CLIENT_ID=""

# Preferred Method (for most developers):
# Create profiles.clj in project root instead:
#   {:dev {:env {:signature "..."
#                :google-client-id "..."
#                :datomic-url "..."}}}
# Then just run: lein repl (variables auto-loaded)

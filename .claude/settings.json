{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": ".claude/hooks/kb-doc-reminder.sh",
            "timeout": 15,
            "statusMessage": "Checking KB docs for this push"
          }
        ]
      }
    ]
  }
}

(ns orcpub.cljs-loader
  "CSP-compatible ClojureScript loader generator (EXPERIMENTAL - NOT USED)

   This namespace provides a :target-fn for the ClojureScript compiler
   that generates a CSP-compatible loader using createElement() instead
   of document.write().

   IMPORTANT: This works with the ClojureScript compiler directly, but
   figwheel-main does NOT pass through :target-fn, so this cannot be
   used with figwheel.

   See scripts/legacy/csp-experiment/README.md for details."
  (:require [clojure.string :as str]))

(defn csp-loader
  "Generate CSP-compatible loader script.

   Usage in dev.cljs.edn (if figwheel supported it):
   {:target-fn orcpub.cljs-loader/csp-loader}

   Works when calling cljs.build.api/build directly:
   (bapi/build src {:target-fn 'orcpub.cljs-loader/csp-loader ...})"
  [opts]
  (let [asset-path (or (:asset-path opts) "/js/compiled/out")
        main-ns (-> opts :main str)
        preloads (or (:preloads opts) [])
        closure-defines (or (:closure-defines opts) {})

        ;; Build CLOSURE_DEFINES JavaScript object
        defines-entries
        (map (fn [[k v]]
               (let [key-str (cond
                               (string? k) k
                               (keyword? k) (name k)
                               (symbol? k) (str k)
                               :else (str k))
                     val-js (cond
                              (string? v) (str "\"" v "\"")
                              (boolean? v) (str v)
                              :else (str v))]
                 (format "  '%s': %s" key-str val-js)))
             closure-defines)

        defines-with-csp (conj (vec defines-entries)
                               "  'goog.ENABLE_CHROME_APP_SAFE_SCRIPT_LOADING': true")

        ;; Build goog.require statements
        require-statements
        (concat
         [(format "goog.require('%s');" (str/replace main-ns "-" "_"))]
         (map #(format "goog.require('%s');" (str/replace (str %) "-" "_"))
              preloads))]

    (str
     "// CSP-compatible loader generated by orcpub.cljs-loader/csp-loader\n"
     "(function() {\n"
     "  'use strict';\n"
     "  var nonce = document.currentScript ? document.currentScript.nonce : '';\n"
     "\n"
     "  window.CLOSURE_DEFINES = {\n"
     (str/join ",\n" defines-with-csp)
     "\n  };\n"
     "\n"
     "  function loadScript(src, cb) {\n"
     "    var s = document.createElement('script');\n"
     "    s.src = src;\n"
     "    if (nonce) s.nonce = nonce;\n"
     "    s.async = false;\n"
     "    if (cb) s.onload = cb;\n"
     "    document.head.appendChild(s);\n"
     "  }\n"
     "\n"
     "  loadScript('" asset-path "/goog/base.js', function() {\n"
     "    loadScript('" asset-path "/cljs_deps.js', function() {\n"
     "      " (str/join "\n      " require-statements) "\n"
     "    });\n"
     "  });\n"
     "})();\n")))

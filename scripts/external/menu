#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# menu - OrcPub Development Hub
# =============================================================================
# A wrapper/hub for starting, stopping, and checking OrcPub services.
# Intended for LOCAL DEVELOPMENT - an alternative to Calva/IDE-based workflows.
#
# Usage:
#   ./menu              Interactive menu
#   ./menu start        Start all services (calls start.sh)
#   ./menu stop         Stop all services (calls stop.sh)
#   ./menu status       Show service status (calls stop.sh --dry-run)
#   ./menu help         Show help
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source shared utilities (colors, logging, port config)
# shellcheck source=common.sh
source "$SCRIPT_DIR/common.sh"

# -----------------------------------------------------------------------------
# Help
# -----------------------------------------------------------------------------

show_help() {
    cat << 'EOF'
OrcPub Development Hub

Usage:
  ./menu              Show interactive menu
  ./menu start        Start all services
  ./menu stop [opts]  Stop services (passes options to stop.sh)
  ./menu status       Show service status
  ./menu help         Show this help

Stop options (passed through to stop.sh):
  --yes, -y           Skip confirmation
  --force, -f         Use SIGKILL if needed
  repl|server|datomic Stop specific service

Examples:
  ./menu                      # Interactive menu
  ./menu start                # Start everything
  ./menu stop                 # Stop all (with confirmation)
  ./menu stop --yes           # Stop all without prompting
  ./menu stop repl --yes      # Stop just nREPL
  ./menu status               # Check what's running
EOF
}

# -----------------------------------------------------------------------------
# Interactive Menu
# -----------------------------------------------------------------------------

show_menu() {
    echo ""
    echo -e "${BOLD}OrcPub Development Hub${NC}"
    echo "══════════════════════════════════════════════════════════════════"
    echo ""
    echo -e "  ${GREEN}Start${NC}"
    echo "  1) Start all (Datomic + Server)"
    echo "  2) Start Datomic only"
    echo "  3) Start Server only"
    echo "  4) Start Figwheel (ClojureScript)"
    echo "  5) Start Garden (CSS)"
    echo "  t) Start all (tmux session)"
    echo "  b) Start all (background)"
    echo ""
    echo -e "  ${YELLOW}Stop${NC}"
    echo "  6) Stop all services"
    echo "  7) Stop Datomic only"
    echo "  8) Stop Server only"
    echo "  9) Stop nREPL only"
    echo ""
    echo -e "  ${CYAN}Other${NC}"
    echo "  d) Init Database"
    echo "  i) Install Datomic"
    echo "  s) Refresh status"
    echo "  h) Help"
    echo "  q) Quit"
    echo ""
}

interactive_menu() {
    local choice
    local timeout_sec=120  # Auto-refresh status every 2 minutes

    while true; do
        # Show status at top of menu
        "$SCRIPT_DIR/stop.sh" --dry-run 2>/dev/null || true

        show_menu

        # Read with timeout for auto-refresh, -r to handle backslash
        if read -t "$timeout_sec" -r -p "Select [1-9, t, b, d, i, s, h, q]: " -n 1 choice; then
            echo ""  # Newline after single-char input
        else
            # Timeout reached - just refresh
            echo ""
            echo -e "${CYAN}[Auto-refresh]${NC}"
            continue
        fi

        case "$choice" in
            1)
                echo ""
                "$SCRIPT_DIR/start.sh"
                ;;
            2)
                echo ""
                "$SCRIPT_DIR/start.sh" datomic
                ;;
            3)
                echo ""
                "$SCRIPT_DIR/start.sh" server
                ;;
            4)
                echo ""
                "$SCRIPT_DIR/start.sh" figwheel
                ;;
            5)
                echo ""
                "$SCRIPT_DIR/start.sh" garden
                ;;
            6)
                echo ""
                "$SCRIPT_DIR/stop.sh"
                ;;
            7)
                echo ""
                "$SCRIPT_DIR/stop.sh" datomic
                ;;
            8)
                echo ""
                "$SCRIPT_DIR/stop.sh" server
                ;;
            9)
                echo ""
                "$SCRIPT_DIR/stop.sh" repl
                ;;
            t|T)
                echo ""
                "$SCRIPT_DIR/start.sh" --tmux
                echo ""
                echo -e "${CYAN}Services started in tmux session 'orcpub'.${NC}"
                echo "Attach with: tmux attach -t orcpub"
                echo ""
                read -r -p "Press Enter to continue..."
                ;;
            b|B)
                echo ""
                "$SCRIPT_DIR/start.sh" --background
                echo ""
                read -r -p "Press Enter to continue..."
                ;;
            d|D)
                echo ""
                "$SCRIPT_DIR/start.sh" init-db
                echo ""
                read -r -p "Press Enter to continue..."
                ;;
            i|I)
                echo ""
                "$SCRIPT_DIR/start.sh" --install
                echo ""
                read -r -p "Press Enter to continue..."
                ;;
            s|S)
                # Loop back to show refreshed status
                ;;
            h|H)
                echo ""
                show_help
                echo ""
                read -r -p "Press Enter to continue..."
                ;;
            q|Q|$'\e')  # q, Q, or Escape
                echo ""
                echo "Goodbye."
                exit 0
                ;;
            "")
                # Enter pressed - just refresh
                ;;
            *)
                echo ""
                echo -e "${YELLOW}Invalid choice: '$choice'${NC}"
                sleep 1
                ;;
        esac
    done
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

main() {
    local command="${1:-}"

    case "$command" in
        "")
            interactive_menu
            ;;
        start)
            shift
            "$SCRIPT_DIR/start.sh" "$@"
            ;;
        stop)
            shift
            "$SCRIPT_DIR/stop.sh" "$@"
            ;;
        status)
            "$SCRIPT_DIR/stop.sh" --dry-run
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            echo "Unknown command: $command"
            show_help
            exit 1
            ;;
    esac
}

main "$@"

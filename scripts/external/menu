#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# menu - OrcPub Development Hub
# =============================================================================
# A wrapper/hub for starting, stopping, and checking OrcPub services.
# Intended for LOCAL DEVELOPMENT - an alternative to Calva/IDE-based workflows.
#
# Usage:
#   ./menu              Interactive menu
#   ./menu start        Start all services (calls start.sh)
#   ./menu stop         Stop all services (calls stop.sh)
#   ./menu status       Show service status (calls stop.sh --dry-run)
#   ./menu help         Show help
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source shared utilities (colors, logging, port config)
# shellcheck source=common.sh
source "$SCRIPT_DIR/common.sh"

# -----------------------------------------------------------------------------
# Help
# -----------------------------------------------------------------------------

show_help() {
    cat << 'EOF'
OrcPub Development Hub

Usage:
  ./menu              Show interactive menu
  ./menu start        Start all services
  ./menu stop [opts]  Stop services (passes options to stop.sh)
  ./menu status       Show service status
  ./menu help         Show this help

Stop options (passed through to stop.sh):
  --yes, -y           Skip confirmation
  --force, -f         Use SIGKILL if needed
  repl|server|datomic Stop specific service

Examples:
  ./menu                      # Interactive menu
  ./menu start                # Start everything
  ./menu stop                 # Stop all (with confirmation)
  ./menu stop --yes           # Stop all without prompting
  ./menu stop repl --yes      # Stop just nREPL
  ./menu status               # Check what's running
EOF
}

# -----------------------------------------------------------------------------
# Status Display
# -----------------------------------------------------------------------------

show_status_header() {
    "$SCRIPT_DIR/stop.sh" --dry-run 2>/dev/null || true
}

# -----------------------------------------------------------------------------
# Submenus
# -----------------------------------------------------------------------------

show_start_submenu() {
    echo ""
    echo -e "${BOLD}Start Services${NC}"
    echo "───────────────────────────────────────"
    echo "  1) Datomic only"
    echo "  2) Server only"
    echo "  3) Figwheel (ClojureScript)"
    echo "  4) Garden (CSS)"
    echo ""
    echo "  a) All (foreground)"
    echo "  t) All (tmux session)"
    echo "  b) All (background)"
    echo ""
    echo "  ←) Back (or press Enter)"
    echo ""
}

handle_start_submenu() {
    local choice
    while true; do
        show_start_submenu
        read -r -p "Select: " -n 1 choice
        echo ""

        case "$choice" in
            1)
                "$SCRIPT_DIR/start.sh" datomic
                return
                ;;
            2)
                "$SCRIPT_DIR/start.sh" server
                return
                ;;
            3)
                "$SCRIPT_DIR/start.sh" figwheel
                return
                ;;
            4)
                "$SCRIPT_DIR/start.sh" garden
                return
                ;;
            a|A)
                "$SCRIPT_DIR/start.sh"
                return
                ;;
            t|T)
                "$SCRIPT_DIR/start.sh" --tmux
                echo ""
                echo -e "${CYAN}Services started in tmux session 'orcpub'.${NC}"
                echo "Attach with: tmux attach -t orcpub"
                echo ""
                read -r -p "Press Enter to continue..."
                return
                ;;
            b|B)
                "$SCRIPT_DIR/start.sh" --background
                echo ""
                read -r -p "Press Enter to continue..."
                return
                ;;
            ""|$'\e'|$'\x7f')  # Enter, Escape, or Backspace
                return
                ;;
            *)
                echo -e "${YELLOW}Invalid choice${NC}"
                sleep 0.5
                ;;
        esac
    done
}

show_stop_submenu() {
    echo ""
    echo -e "${BOLD}Stop Services${NC}"
    echo "───────────────────────────────────────"
    echo "  1) Stop all"
    echo "  2) Datomic only"
    echo "  3) Server only"
    echo "  4) nREPL only"
    echo "  5) Figwheel only"
    echo ""
    echo "  ←) Back (or press Enter)"
    echo ""
}

handle_stop_submenu() {
    local choice
    while true; do
        show_stop_submenu
        read -r -p "Select: " -n 1 choice
        echo ""

        case "$choice" in
            1)
                "$SCRIPT_DIR/stop.sh"
                read -r -p "Press Enter to continue..."
                return
                ;;
            2)
                "$SCRIPT_DIR/stop.sh" datomic
                read -r -p "Press Enter to continue..."
                return
                ;;
            3)
                "$SCRIPT_DIR/stop.sh" server
                read -r -p "Press Enter to continue..."
                return
                ;;
            4)
                "$SCRIPT_DIR/stop.sh" repl
                read -r -p "Press Enter to continue..."
                return
                ;;
            5)
                "$SCRIPT_DIR/stop.sh" figwheel
                read -r -p "Press Enter to continue..."
                return
                ;;
            ""|$'\e'|$'\x7f')
                return
                ;;
            *)
                echo -e "${YELLOW}Invalid choice${NC}"
                sleep 0.5
                ;;
        esac
    done
}

show_utils_submenu() {
    echo ""
    echo -e "${BOLD}Utilities${NC}"
    echo "───────────────────────────────────────"
    echo "  d) Init Database"
    echo "  i) Install Datomic"
    echo "  c) Check prerequisites"
    echo "  r) Refresh status"
    echo ""
    echo "  ←) Back (or press Enter)"
    echo ""
}

handle_utils_submenu() {
    local choice
    while true; do
        show_utils_submenu
        read -r -p "Select: " -n 1 choice
        echo ""

        case "$choice" in
            d|D)
                "$SCRIPT_DIR/start.sh" init-db
                echo ""
                read -r -p "Press Enter to continue..."
                return
                ;;
            i|I)
                "$SCRIPT_DIR/start.sh" --install
                echo ""
                read -r -p "Press Enter to continue..."
                return
                ;;
            c|C)
                "$SCRIPT_DIR/start.sh" --check
                echo ""
                read -r -p "Press Enter to continue..."
                return
                ;;
            r|R)
                return  # Just return to refresh main menu
                ;;
            ""|$'\e'|$'\x7f')
                return
                ;;
            *)
                echo -e "${YELLOW}Invalid choice${NC}"
                sleep 0.5
                ;;
        esac
    done
}

# -----------------------------------------------------------------------------
# Main Menu
# -----------------------------------------------------------------------------

show_main_menu() {
    echo ""
    echo -e "${BOLD}OrcPub Development Hub${NC}"
    echo "══════════════════════════════════════════════════════════════════"
    echo ""
    echo -e "${GREEN}Quick Actions${NC}"
    echo "  1) Start Datomic          ← most common"
    echo "  2) Stop all services"
    echo "  q) Quit"
    echo ""
    echo -e "${CYAN}More${NC}"
    echo "  s) Start services →"
    echo "  x) Stop services →"
    echo "  u) Utilities →"
    echo "  h) Help"
    echo ""
}

interactive_menu() {
    local choice
    local timeout_sec=120  # Auto-refresh status every 2 minutes

    while true; do
        # Show status at top of menu
        show_status_header
        show_main_menu

        # Read with timeout for auto-refresh, -r to handle backslash
        if read -t "$timeout_sec" -r -p "Select [1-2, s, x, u, h, q]: " -n 1 choice; then
            echo ""  # Newline after single-char input
        else
            # Timeout reached - just refresh
            echo ""
            echo -e "${CYAN}[Auto-refresh]${NC}"
            continue
        fi

        case "$choice" in
            1)
                echo ""
                "$SCRIPT_DIR/start.sh" datomic
                ;;
            2)
                echo ""
                "$SCRIPT_DIR/stop.sh"
                read -r -p "Press Enter to continue..."
                ;;
            s|S)
                handle_start_submenu
                ;;
            x|X)
                handle_stop_submenu
                ;;
            u|U)
                handle_utils_submenu
                ;;
            h|H)
                echo ""
                show_help
                echo ""
                read -r -p "Press Enter to continue..."
                ;;
            q|Q|$'\e')  # q, Q, or Escape
                echo ""
                echo "Goodbye."
                exit 0
                ;;
            "")
                # Enter pressed - just refresh
                ;;
            *)
                echo ""
                echo -e "${YELLOW}Invalid choice: '$choice'${NC}"
                sleep 1
                ;;
        esac
    done
}

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

main() {
    local command="${1:-}"

    case "$command" in
        "")
            interactive_menu
            ;;
        start)
            shift
            "$SCRIPT_DIR/start.sh" "$@"
            ;;
        stop)
            shift
            "$SCRIPT_DIR/stop.sh" "$@"
            ;;
        status)
            "$SCRIPT_DIR/stop.sh" --dry-run
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            echo "Unknown command: $command"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
